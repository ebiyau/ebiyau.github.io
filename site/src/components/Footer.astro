---
import { SITE } from '../consts';
---

<footer>
	<span>© {new Date().getFullYear()} {SITE.name}</span>
</footer>

<style>
	footer {
		max-width: var(--page);
		margin: 0 auto;
		padding: 2rem 1.25rem 3rem;
		border-top: 1px solid var(--faint);
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.5rem 1.5rem;
		font-size: 0.95rem;
	}
</style>
