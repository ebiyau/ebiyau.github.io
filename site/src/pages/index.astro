---
import Base from '../layouts/Base.astro';
import Profile from '../components/Profile.astro';
import Publication from '../components/Publication.astro';
import { SITE, NEWS, PUBLICATIONS, TEACHING, SERVICE } from '../consts';
---

<Base>
	<div class="layout">
		<Profile />

		<div class="content">
			<section id="about">
				<h1>{SITE.name}</h1>
				<p class="lede">
					I’m a first-year Ph.D. student in Electrical and Computer Engineering at Carnegie Mellon
					University and the University of Porto, in the CMU Portugal dual-degree program. I’m advised by{' '}
					<a href="https://users.ece.cmu.edu/~agr/">Anthony Rowe</a> (<a href="https://wise.ece.cmu.edu/"
						>WiseLab</a
					>) and <a href="https://www.inesctec.pt/en/people/jaime-cardoso">Jaime Cardoso</a> (<a
						href="https://vcmi.inesctec.pt/">VCMI</a
					>).
				</p>
				<p class="lede">
					Before the Ph.D., I completed my master’s at CMU with{' '}
					<a href="https://africa.engineering.cmu.edu/about/contact/directory/bios/barros-joao.html"
						>João Barros</a
					>, where I studied how drivers in African cities respond to informal transport modes. My
					undergraduate degree is from Makerere University in Kampala.
				</p>
			</section>

			<section id="news">
				<h2>News</h2>
				<ul class="news">
					{
						NEWS.map((item) => (
							<li>
								<span class="when">{item.date}</span>
								<span>{item.href ? <a href={item.href}>{item.text}</a> : item.text}</span>
							</li>
						))
					}
				</ul>
			</section>

			<section id="research">
				<h2>Research</h2>
				<p class="lede">
					I work on radar perception, and currently on how radar and cameras should be combined. Radar is
					usually treated as a backup for when cameras fail: in bad weather, at night, or behind occlusion.
					I’m interested in what it contributes beyond those cases, since it measures range and velocity
					directly where a camera has to infer them. I’m studying where radar outperforms cameras, and what
					that implies for how, and at what stage of a model, the two sensors should be fused.
				</p>
				<p class="lede">
					I’m also building an open-source implementation of Doppler-division MIMO for single-chip radars.
				</p>
			</section>

			<section id="publications">
				<h2>Publications</h2>
				<ol class="pubs">
					{PUBLICATIONS.map((pub) => <Publication pub={pub} />)}
				</ol>
			</section>

			<section id="teaching">
				<h2>Teaching</h2>
				<ul class="rows">
					{
						TEACHING.map((item) => (
							<li>
								<span class="course">
									<strong>{item.role}</strong>
									{item.href ? <a href={item.href}>{item.course}</a> : <span>{item.course}</span>}
								</span>
								<span class="when">{item.term}</span>
							</li>
						))
					}
				</ul>
			</section>

			<section id="service">
				<h2>Service</h2>
				<ul class="rows">
					{
						SERVICE.map((item) => (
							<li>
								<span class="course">
									<strong>{item.title}</strong>
									<span>{item.detail}</span>
								</span>
							</li>
						))
					}
				</ul>
			</section>
		</div>
	</div>
</Base>

<style>
	.layout {
		display: grid;
		grid-template-columns: 220px minmax(0, 1fr);
		gap: 4.5rem;
		align-items: start;
	}

	.content {
		max-width: var(--measure);
	}

	.content section + section {
		margin-top: 3.5rem;
	}

	h2 {
		font-weight: 600;
		margin-top: 0;
		margin-bottom: 1.25rem;
	}

	#about a,
	#news a,
	#research a,
	#teaching a {
		text-decoration-color: var(--accent);
	}

	.news {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.6rem;
		font-size: 1.05rem;
		line-height: 1.5;
	}

	.news li {
		display: grid;
		grid-template-columns: 5.5rem minmax(0, 1fr);
		gap: 1rem;
	}

	.news .when {
		color: var(--subtle);
	}

	.lede {
		font-size: 1.2rem;
		line-height: 1.6;
	}

	.pubs {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.rows {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 1.1rem;
	}

	.rows li {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 1rem;
		font-size: 1.05rem;
	}

	.rows .course {
		display: flex;
		flex-direction: column;
		line-height: 1.5;
	}

	.rows strong {
		font-weight: 500;
	}

	.when {
		flex-shrink: 0;
		font-size: 0.95rem;
		font-variant-numeric: tabular-nums;
	}

	@media (max-width: 720px) {
		.layout {
			grid-template-columns: 1fr;
			gap: 3rem;
		}
	}
</style>
